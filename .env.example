PORT=3002

# Public HTTPS base URL of this service (Cloudflare tunnel / Railway / VPS)
# Used for CORS allowlist checks and invoice deep links
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Allowed storefront origins (comma-separated)
CORS_ORIGINS=https://keshavclothing.com,https://www.keshavclothing.com,https://keshav-clothing-2.myshopify.com

# ===== Meta WhatsApp Cloud API (Business Manager → WhatsApp → API Setup) =====
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v21.0

# Optional: verify token for Meta webhook subscription
META_WEBHOOK_VERIFY_TOKEN=kc_wa_verify_change_me
META_APP_SECRET=

# Message template names (must be APPROVED in Meta Business Manager)
# OTP stays on Axentra SMS — do NOT use WA for OTP.
# Create these utility templates (or rename here to match yours):
#   kc_order_confirmed  — vars: {{1}} name, {{2}} order#, {{3}} total, {{4}} invoice_url
#   kc_order_shipped    — vars: {{1}} name, {{2}} order#, {{3}} carrier, {{4}} tracking_url
#   kc_order_in_transit — vars: {{1}} name, {{2}} order#, {{3}} tracking_url
#   kc_order_delivered  — vars: {{1}} name, {{2}} order#
#   kc_order_cancelled  — vars: {{1}} name, {{2}} order#
WA_TEMPLATE_ORDER_CONFIRMED=kc_order_confirmed
WA_TEMPLATE_ORDER_SHIPPED=kc_order_shipped
WA_TEMPLATE_ORDER_IN_TRANSIT=kc_order_in_transit
WA_TEMPLATE_ORDER_DELIVERED=kc_order_delivered
WA_TEMPLATE_ORDER_CANCELLED=kc_order_cancelled
WA_TEMPLATE_LANGUAGE=en

# Fallback: if templates not approved yet, send plain text (only works inside 24h session)
WA_ALLOW_PLAINTEXT_FALLBACK=1

# Store support WhatsApp (E.164 without +) — receives return/exchange alerts
STORE_WHATSAPP_NUMBER=919974033803
STORE_NAME=Keshav Clothing
STORE_INVOICE_BASE_URL=https://keshavclothing.com/account/orders

# ===== Shopify Admin (order notes for returns + order status lookup) =====
# Live shop domain (myshopify) — Axentra / storefront use h1bfui-vi:
SHOPIFY_SHOP=h1bfui-vi.myshopify.com
# CLI sometimes shows keshav-clothing-2.myshopify.com — same store; prefer h1bfui-vi for WA phone matching
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=
SKIP_WEBHOOK_HMAC=1

# Return window (days after fulfillment / order date)
RETURN_WINDOW_DAYS=15

# Team chat inbox at /inbox (allowlisted emails only)
INBOX_ENABLED=1
INBOX_PASSWORD=
INBOX_TOKEN_SECRET=
INBOX_ALLOWED_EMAILS=keshavclothingkc@gmail.com
# Optional but recommended: Google OAuth Web Client ID (Sign in with Google)
INBOX_GOOGLE_CLIENT_ID=
# Forever chat history (FREE — Turso). Required on Render free plan (no disks).
# https://turso.tech → create DB → copy URL + token into Render Environment
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=
# Optional local cache path (ignored for forever history without Turso)
DATA_DIR=

